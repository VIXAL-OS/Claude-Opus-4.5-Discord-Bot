# Discord Bot Token
# Get from: https://discord.com/developers/applications → Your App → Bot → Token
DISCORD_TOKEN=your_discord_bot_token_here

# Anthropic API Key
# Get from: https://console.anthropic.com/
# Don't forget to add credits first!
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Deepseek API Key (OPTIONAL - bot works without it, Claude-only mode)
# Get from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Gemini API Key (OPTIONAL - completes the MAGI trinity)
# Get from: https://aistudio.google.com/apikey
# Uses Google's OpenAI-compatible endpoint (no new SDK required).
GEMINI_API_KEY=your_gemini_api_key_here

# Fireworks API Key (OPTIONAL - enables the open-weight heads Qwen (Rei) + GLM (Asuka))
# One key, one endpoint, US zero-data-retention. Get from: https://fireworks.ai/
# Prepaid as of July 2026 — buy credits and set auto-reload so calls don't fail at $0.
# (Mistral Large 3 is NOT on Fireworks serverless — see MISTRAL_API_KEY below.)
FIREWORKS_API_KEY=your_fireworks_api_key_here

# Mistral API Key (OPTIONAL - enables Mistral (Mari): French/EU specialist + the !french tutor)
# Mistral's own API (api.mistral.ai) — EU-resident, runs on France's low-carbon grid.
# Get from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Tavily API Key (OPTIONAL - enables web search for Deepseek)
# Gemini uses Google's native grounding (no Tavily needed) when GEMINI_API_KEY is set.
# Get from: https://tavily.com/ (free: 1000 searches/month)
TAVILY_API_KEY=your_tavily_api_key_here

# Azure Speech (OPTIONAL - enables the !speak (Mandarin) and !french (French) TTS commands)
# The only mainstream TTS that lets the bot FORCE exact tones via SSML
# <phoneme>, which is what matters for teaching pronunciation. Free tier:
# 0.5M chars/month. In the Azure portal create a "Speech service" resource,
# then copy Key 1 into AZURE_TTS_KEY and the resource's Location/Region
# (e.g. eastus, westus2, southeastasia) into AZURE_TTS_REGION.
AZURE_TTS_KEY=
AZURE_TTS_REGION=

# AO3 Session Cookie (OPTIONAL - for bookclub mode when AO3 is "shields-up")
# When AO3 is under heavy load it returns 403 "Shields are up!" to anonymous
# requests. Logged-in sessions bypass this AND can access registered-only works.
# To populate: log in at archiveofourown.org in your browser → open dev tools →
# Application/Storage → Cookies → archiveofourown.org → copy the value of
# `_otwarchive_session`. Paste that value here (no "Cookie:" prefix needed).
# The cookie typically lasts ~2 weeks; refresh when !load starts failing again.
AO3_COOKIE=
